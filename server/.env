# ============================================================================
# GridZero Server — Environment Configuration
# ============================================================================

# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=Electronics_Lab
DB_CONNECTION_LIMIT=10

# CORS (allow dashboard to connect)
CORS_ORIGIN=*

# ESP32-CAM Stream URL (update when hardware is ready)
ESP32_CAM_URL=http://192.168.1.100:81/stream

# Camera AI Vision Detection
# Capture URL fetches a single JPEG snapshot for AI analysis
ESP32_CAM_CAPTURE_URL=http://192.168.1.100:81/capture
VISION_ANALYSIS_INTERVAL_MS=3000
VISION_CONFIDENCE_THRESHOLD=0.4
